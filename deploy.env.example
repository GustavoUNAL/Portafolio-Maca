# Copia este archivo a deploy.env y completa tus datos:
#   cp deploy.env.example deploy.env

# SSH del VPS
VPS_HOST=usuario@TU_IP_O_DOMINIO
VPS_PORT=22

# Ruta absoluta de WordPress en el VPS
VPS_WP_PATH=/var/www/maca

# Dominio público (con https)
LIVE_URL=https://TU-DOMINIO.com

# URL local actual
LOCAL_URL=http://portafolio.local

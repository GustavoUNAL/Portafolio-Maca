# Copia este archivo a deploy.env y completa tus datos:
#   cp deploy.env.example deploy.env

# SSH del VPS
VPS_HOST=ubuntu@51.222.24.228
VPS_PORT=22

# Ruta absoluta de WordPress en el VPS
VPS_WP_PATH=/var/www/justcamm

# Dominio público (con https) — Caddy gestiona el SSL
# DNS: A portafolio → IP del VPS  →  portafolio.justcamm.online
LIVE_URL=https://portafolio.justcamm.online

# URL local actual
LOCAL_URL=http://portafolio.local

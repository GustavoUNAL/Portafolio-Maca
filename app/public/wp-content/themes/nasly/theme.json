{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "ink", "name": "Body Plum", "color": "#3C183C" },
				{ "slug": "ink-2", "name": "Plum Deep", "color": "#26102A" },
				{ "slug": "surface", "name": "Plum Surface", "color": "#4E2452" },
				{ "slug": "line", "name": "Plum Line", "color": "#6B3A6F" },
				{ "slug": "text", "name": "Fresh Lime", "color": "#CDFC8A" },
				{ "slug": "muted", "name": "Lime Soft", "color": "#A8D96A" },
				{ "slug": "dim", "name": "Lime Dim", "color": "#7AA84E" },
				{ "slug": "magenta", "name": "Fresh Lime", "color": "#CDFC8A" },
				{ "slug": "violet", "name": "Fresh Lime", "color": "#CDFC8A" },
				{ "slug": "moss", "name": "Fresh Lime", "color": "#CDFC8A" },
				{ "slug": "white", "name": "Lime Bright", "color": "#E8FFB0" }
			]
		},
		"custom": {
			"ink-soft": "#D2CBFE",
			"moss": "#CDFC8A"
		},
		"layout": {
			"contentSize": "660px",
			"wideSize": "1180px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "2", "size": "8px" },
				{ "slug": "30", "name": "3", "size": "16px" },
				{ "slug": "40", "name": "4", "size": "24px" },
				{ "slug": "50", "name": "5", "size": "clamp(28px, 4vw, 40px)" },
				{ "slug": "60", "name": "6", "size": "clamp(44px, 6vw, 64px)" },
				{ "slug": "70", "name": "7", "size": "clamp(56px, 8vw, 88px)" },
				{ "slug": "80", "name": "8", "size": "5.06rem" }
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Rubik Distressed\", Impact, sans-serif",
					"name": "Rubik Distressed",
					"slug": "rubik-distressed",
					"fontFace": [
						{
							"fontFamily": "Rubik Distressed",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/rubik-distressed-400.woff2"]
						}
					]
				},
				{
					"fontFamily": "\"Rubik Dirt\", Impact, sans-serif",
					"name": "Rubik Dirt",
					"slug": "rubik-dirt",
					"fontFace": [
						{
							"fontFamily": "Rubik Dirt",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/rubik-dirt-400.woff2"]
						}
					]
				},
				{
					"fontFamily": "\"Fraunces\", \"Iowan Old Style\", Georgia, serif",
					"name": "Fraunces",
					"slug": "fraunces",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/fraunces-variable.woff2"]
						},
						{
							"fontFamily": "Fraunces",
							"fontWeight": "100 900",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/fraunces-variable-italic.woff2"]
						}
					]
				},
				{
					"fontFamily": "\"Manrope\", \"Segoe UI\", sans-serif",
					"name": "Manrope",
					"slug": "manrope",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/manrope-variable.woff2"]
						}
					]
				},
				{
					"fontFamily": "\"JetBrains Mono\", ui-monospace, monospace",
					"name": "JetBrains Mono",
					"slug": "jetbrains-mono",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/jetbrains-mono-400.woff2"]
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/jetbrains-mono-500.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "XS", "size": "0.69rem" },
				{ "slug": "small", "name": "Small", "size": "0.92rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.02rem" },
				{ "slug": "lede", "name": "Lede", "size": "clamp(1.08rem, 1.08rem + ((1vw - 0.2rem) * 0.45), 1.32rem)" },
				{ "slug": "large", "name": "Large", "size": "clamp(1.7rem, 1.7rem + ((1vw - 0.2rem) * 1.8), 2.7rem)" },
				{ "slug": "x-large", "name": "X Large", "size": "clamp(3rem, 3rem + ((1vw - 0.2rem) * 6.4), 6.4rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ink)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"padding": {
				"top": "0px",
				"right": "clamp(16px, 4vw, 30px)",
				"bottom": "0px",
				"left": "clamp(16px, 4vw, 30px)"
			},
			"blockGap": "16px"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--violet)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--magenta)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--text)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fraunces)",
					"fontWeight": "700",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.05"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"letterSpacing": "-0.04em",
					"lineHeight": "0.94"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "clamp(0.95rem, 0.95rem + ((1vw - 0.2rem) * 0.5), 1.2rem)",
					"fontWeight": "700",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.3"
				}
			},
			"button": {
				"border": { "radius": "999px", "width": "0" },
				"color": {
					"background": "var(--wp--preset--color--magenta)",
					"text": "#022E21"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "0.82rem",
					"fontWeight": "700",
					"letterSpacing": "0.04em",
					"textTransform": "none",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"right": "24px",
						"bottom": "14px",
						"left": "24px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--violet)",
						"text": "#022E21"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--dim)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--jetbrains-mono)",
					"fontSize": "0.67rem",
					"letterSpacing": "0.11em",
					"textTransform": "uppercase"
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fraunces)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Cabecera", "area": "header" },
		{ "name": "footer", "title": "Pie", "area": "footer" }
	],
	"customTemplates": [
		{
			"name": "page-portafolio",
			"title": "Página Portafolio",
			"postTypes": ["page"]
		},
		{
			"name": "page-visual-journal",
			"title": "Visual Journal",
			"postTypes": ["page"]
		}
	]
}
